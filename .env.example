# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file.
# Keep only the variables each topic folder actually needs.

# ---------- LLM providers ----------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here          # only if you use OpenAI embeddings or models

# Default model to use in examples
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- RAG / vector databases ----------
# Pick the ones you use
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=your-index-name
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here          # only for hosted Qdrant

# ---------- Memory ----------
# e.g. Mem0 or a database-backed store
MEM0_API_KEY=your-mem0-api-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---------- Inngest ----------
INNGEST_EVENT_KEY=your-inngest-event-key-here
INNGEST_SIGNING_KEY=your-inngest-signing-key-here
# Set to 1 when running the local Inngest dev server
INNGEST_DEV=1

# ---------- MCP ----------
# Credentials for any third-party services your MCP server talks to
GITHUB_TOKEN=your-github-personal-access-token-here

# ---------- App ----------
PORT=3000
NODE_ENV=development
